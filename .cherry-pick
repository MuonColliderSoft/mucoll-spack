# Patches applied to the pinned spack-packages checkout (after key4hep-spack's
# own .cherry-pick), sourced from the spack-packages root by Docker/Dockerfile.base.
# Each version is only added if the recipe does not already have it, so these
# stay harmless once upstream catches up (then drop them).

# edm4hep: add v1.3 (tag v01-03), not yet in spack-packages. Same dependencies
# as 1.1 (podio@1.7:).
EDM4HEP_PKG=repos/spack_repo/builtin/packages/edm4hep/package.py
grep -q 'version("1.3"' ${EDM4HEP_PKG} || \
  sed -i 's/^\( *\)version("main", branch="main")$/&\n\1version("1.3", sha256="e6d5ba2513066d145fd2f9c4cd98aa94dba2eb4b5b3dcd698ded3980d70b815f")/' \
    ${EDM4HEP_PKG}

# k4geo: add v00-27 (MAIA_v1, MAIA/MUSIC material and beampipe fixes), not yet
# in key4hep-spack. The recipe lives in the key4hep-spack checkout, not in
# spack-packages, hence the absolute path.
K4GEO_PKG=${SPACK_ROOT}/var/key4hep-spack/packages/k4geo/package.py
grep -q '"00-27"' ${K4GEO_PKG} || \
  sed -i 's/^\( *\)version("main", branch="main")$/&\n\1version("00-27", sha256="6fe4d6dd5e938bcb9783cff424b21a0efb6262dbbef1340412eb044c6c2efbca")/' \
    ${K4GEO_PKG}
