# Pull latest py-numba (0.66.0) + py-llvmlite (0.48.0) recipes (acorn ->
# py-numba pulls them in). py-llvmlite@0.48 needs llvm@22, which the llvm recipe
# below provides.
# The upstream commits don't cherry-pick cleanly onto this image's older
# spack-packages, so check out the package files at that commit instead.
git remote add upstream https://github.com/spack/spack-packages.git 2>/dev/null || true
git fetch --depth 50 upstream a2c63786aa875edbef612dd506d7a855c28b0cca
git checkout a2c63786aa875edbef612dd506d7a855c28b0cca -- \
  repos/spack_repo/builtin/packages/py_numba/package.py \
  repos/spack_repo/builtin/packages/py_llvmlite/package.py

# Pull the latest llvm recipe (adds llvm@22 and @23), which is built inside the
# stack. The whole package directory is checked out so its patches come along.
git fetch --depth 50 upstream 27d366be7b94044f06915797fe99db9de7a171be
git checkout 27d366be7b94044f06915797fe99db9de7a171be -- \
  repos/spack_repo/builtin/packages/llvm

# geant4 examples
git cherry-pick 334aeef7ffd810fe7c15c9ba9b6c3033ba4bf899 -X theirs --no-commit

# py-matplotlib: depend on gmake when %gcc (spack/spack-packages#2526). gcc's
# lto-wrapper runs `make` from PATH while linking the extension modules; without
# a gmake dep Spack's new installer exports the fifo jobserver form, which the
# system make 4.3 (RHEL 9, Ubuntu 24.04) cannot parse ("invalid
# --jobserver-auth string"). Drop once the spack-packages pin includes #2526.
git fetch --depth 50 upstream c09b3343a23069e9e309dfee4083a05327c827bc
git cherry-pick c09b3343a23069e9e309dfee4083a05327c827bc --no-commit

# Pull the latest py-pytorch-lightning recipe (adds 2.5.3 / 2.6.x and deprecates
# the releases with CVEs); the pinned spack-packages stops at 2.0.7. acorn
# imports `pytorch_lightning`, which the unified py-lightning package does not
# ship, and acorn 2.x targets lightning 2.4.
git fetch --depth 50 upstream fba5ebd6e68757285d97e14050addc5ecf1e4b6f
git checkout fba5ebd6e68757285d97e14050addc5ecf1e4b6f -- \
  repos/spack_repo/builtin/packages/py_pytorch_lightning/package.py

# Pull the py-uv-build recipe (not in the pinned spack-packages): the build
# backend of py-class-resolver@0.7: (acorn -> py-class-resolver).
git fetch --depth 50 upstream 5ee3e6b85e10f1ff8189f549dae13198f5cec4ac
git checkout 5ee3e6b85e10f1ff8189f549dae13198f5cec4ac -- \
  repos/spack_repo/builtin/packages/py_uv_build/package.py
