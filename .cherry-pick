# Patches applied to the pinned spack-packages checkout (after key4hep-spack's
# own .cherry-pick), sourced from the spack-packages root by Docker/Dockerfile.base.

# edm4hep: add v1.2 (tag v01-02), not yet in spack-packages. Same dependencies
# as 1.1 (podio@1.7:). Drop once the spack-packages pin has edm4hep@1.2.
sed -i 's/^\( *\)version("main", branch="main")$/&\n\1version("1.2", sha256="de20ce7ac6af486224fd9ffaa2c9dd367ad89cf55f19cd47f83459fde2d9b1c9")/' \
  repos/spack_repo/builtin/packages/edm4hep/package.py
